float sdf_rounded_box(float2 p, float2 size, float r) { float2 q = abs(p) - size + r; return length(max(q, 0.0)) - r; } void DynamicSquare_float(float2 UV, float CornerRad, float Width, float3 BaseColor, out float4 outColor) { float2 p = UV - 0.5; float sd = sdf_rounded_box(p, float2(Width, Width) * 0.5, CornerRad); float aa = max(fwidth(sd), 1e-5); float fill = 1 - smoothstep(0.0, aa, sd); outColor = float4(BaseColor * fill, 1.0); }