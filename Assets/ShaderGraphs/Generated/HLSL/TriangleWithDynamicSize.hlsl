void TriangleWithDynamicSize_float(float2 UV, float size, out float4 outColor) { float3 p = float3(UV, 1.0f); float2 p0 = float2(0.5, 0.5 + size / 3.0f); float2 p1 = float2(0.5 - size / 2.0f, 0.5 - size / 3.0f); float2 p2 = float2(0.5 + size / 2.0f, 0.5 - size / 3.0f); float alpha = 0.0f; float area = size * size * 0.5f; float a = length(cross(float3(p1 - p0, 0.0), float3(p2 - p0, 0.0))) * 0.5f; float a0 = length(cross(float3(p - p1, 0.0), float3(p2 - p1, 0.0))) * 0.5f; float a1 = length(cross(float3(p - p2, 0.0), float3(p0 - p2, 0.0))) * 0.5f; float a2 = length(cross(float3(p - p0, 0.0), float3(p1 - p0, 0.0))) * 0.5f; alpha = (abs(a - (a0 + a1 + a2)) < 0.01) ? 1.0 : 0.0; outColor = float4(1.0, 0.0, 1.0, alpha); }