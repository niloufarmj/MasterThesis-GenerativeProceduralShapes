float sd_star(float2 p, float2 n, float r, float innerR, int arms) { float an = atan2(p.y, p.x) + PI; float t = 2.0 * PI / float(arms); float d = cos(floor(0.5 + an / t) * t - an) * length(p); return min(max(d, (length(p) - innerR)), (length(p) - r)); } float rotate_and_scale(float2 p, float angle, float scale) { float c = cos(angle); float s = sin(angle); p *= scale; return float2(p.x * c - p.y * s, p.x * s + p.y * c); } void RotatableStar_float(float2 UV, float rotationDegrees, float scale, float size, float innerSize, int arms, out float4 outColor) { float2 p = UV - float2(0.5, 0.5); p = rotate_and_scale(p, rotationDegrees * PI / 180.0, scale); float sd = sd_star(p, float2(0,0), size, innerSize, arms); float aa = max(fwidth(sd), 1e-5); float fill = 1.0 - smoothstep(0.0, aa, sd); outColor = float4(fill, fill, fill, 1.0); }