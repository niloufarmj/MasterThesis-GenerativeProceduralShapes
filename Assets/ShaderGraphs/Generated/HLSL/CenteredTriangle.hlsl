void CenteredTriangle_float(float2 UV, float size, out float4 outColor) { float3 p1 = float3(0.5, 0.5 - size * 0.866, 0.0); float3 p2 = float3(0.5 - size * 0.5, 0.5 + size * 0.5 * 0.866, 0.0); float3 p3 = float3(0.5 + size * 0.5, 0.5 + size * 0.5 * 0.866, 0.0); float area = 0.5 * (-p2.y * p3.x + p1.y * (-p2.x + p3.x) + p1.x * (p2.y - p3.y) + p2.x * p3.y); float s = 1 / (2 * area) * (p1.y * p3.x - p1.x * p3.y + (p3.y - p1.y) * UV.x + (p1.x - p3.x) * UV.y); float t = 1 / (2 * area) * (p1.x * p2.y - p1.y * p2.x + (p1.y - p2.y) * UV.x + (p2.x - p1.x) * UV.y); if (s >= 0 && t >= 0 && (s + t) <= 1) { outColor = float4(1.0, 0.0, 0.0, 1.0); } else { outColor = float4(0.0, 0.0, 0.0, 0.0); } }