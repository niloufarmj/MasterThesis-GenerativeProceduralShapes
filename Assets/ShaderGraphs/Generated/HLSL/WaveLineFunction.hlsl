void WaveLineFunction_float(float2 UV, float Amplitude, float Frequency, float3 Color, out float4 outColor) {\n    // Center UV coordinates and scale\n    float2 centered = UV - float2(0.5, 0.5);\n    \n    // Compute wave along y-axis\n    float wave = Amplitude * sin(Frequency * centered.x * 3.14159265 * 2.0);\n    \n    // Compute signed distance for the line at y = wave\n    float dist = centered.y - wave;\n    \n    // Anti-aliased edge\n    float edge = smoothstep(0.01, -0.01, dist);\n    \n    // Final color output with smoothing\n    outColor = float4(Color * edge, edge);\n}