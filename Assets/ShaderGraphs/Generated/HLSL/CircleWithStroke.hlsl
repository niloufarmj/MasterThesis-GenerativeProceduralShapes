float sd_circle(float2 p, float r) { return length(p) - r; } void CircleWithStroke_float(float2 UV, float radius, float thickness, out float4 outColor) { float2 p = UV - 0.5; float circle_sd = sd_circle(p, radius); float edge_sd = abs(circle_sd) - thickness; float aa = max(fwidth(edge_sd), 1e-5); float fill = 1 - smoothstep(0.0, aa, edge_sd); float3 BaseColor = float3(1,1,1); outColor = float4(BaseColor * fill, 1.0); }